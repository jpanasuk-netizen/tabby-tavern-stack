{
  "mcpServers": {
    "host-master": {
      "command": "/app/.venv/bin/python3",
      "args": ["/opt/mcp-servers/server.py"],
      "env": {
        "TABBYAPI_URL": "http://tabbyapi:5000",
        "OLLAMA_URL": "http://ollama:11434",
        "TABBYAPI_KEY": "${TABBYAPI_KEY}"
      }
    },
    "tavern": {
      "command": "python3",
      "args": ["/opt/mcp-servers/tavern_mcp.py"]
    }
  }
}
